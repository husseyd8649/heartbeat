# Local mode is zero-config. Set STORE_MODE=neon for production persistence.
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORE_MODE=memory
DEMO_ORGANIZATION_ID=demo-org
DEMO_ORGANIZATION_NAME=Northstar Labs

# Clerk Organizations
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon
DATABASE_URL=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Heartbeat Alerts <alerts@example.com>

# Worker and API protection
CHECK_RUNNER_TOKEN=change-me

# Security
WEBHOOK_MAX_AGE_SECONDS=300
